# Banco de dados (MongoDB)
DATABASE_URL=

# Autenticação
JWT_SECRET=

# Porta do servidor (opcional, padrão 3000)
PORT=3000

# Cloudinary (armazenamento de fotos)
# Pegue esses valores no Dashboard: https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# CORS - URL do frontend em produção (ex: https://fisga-club.vercel.app)
FRONTEND_URL=
